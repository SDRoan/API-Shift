# Copy to .env and fill in. .env is gitignored and must never be committed.

# GitHub personal access token with repo scope.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# The throwaway repo APIShift opens pull requests against.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# Local Ollama. Used only for low confidence draft suggestions.
# The pipeline still works when Ollama is not running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local SQLite database for tracked specs and run history.
APISHIFT_DB=.apishift/apishift.db
